        },
        {
          "path": "**/*.[bB][aA][tT]"
        },
        {
          "path": "**/*.[cC][mM][dD]"
        },
        {
          "path": "**/*.[pP][sS]1"
        },
        {
          "path": "**/*.[pP][sS][mM]1"
        },
        {
          "path": "**/*.[vV][bB][sS]"
        },
        {
          "path": "**/*.[vV][bB][eE]"
        },
        {
          "path": "**/*.[jJ][sS]"
        },
        {
          "path": "**/*.[jJ][sS][eE]"
        },
        {
          "path": "**/*.[wW][sS][fF]"
        },
        {
          "path": "**/*.[wW][sS][hH]"
