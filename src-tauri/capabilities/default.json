        {
          "path": "**/*.[hH][tT][aA]"
        },
        {
          "path": "**/*.[mM][sS][iI]"
        },
        {
          "path": "**/*.[mM][sS][pP]"
        },
        {
          "path": "**/*.[mM][sS][iI][xX]"
        },
        {
          "path": "**/*.[aA][pP][pP][xX]"
        },
        {
          "path": "**/*.[lL][nN][kK]"
        },
        {
          "path": "**/*.[uU][rR][lL]"
